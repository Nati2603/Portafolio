        <mxCell id="nkpL2B2TygAPKRpP-Ec0-22" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;PROYECTOS&lt;/h1&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="40" width="190" x="319" y="800" as="geometry" />
