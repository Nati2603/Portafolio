        <mxCell id="nkpL2B2TygAPKRpP-Ec0-27" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;labelBorderColor=default;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Proyecto Vocacional&lt;/h1&gt;&lt;p&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 14px;&quot;&gt;A&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;compaño a los estudiantes en giras y actividades que los ayudan a explorar opciones profesionales y a construir un proyecto de vida más consciente y significativo&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="180" x="50" y="880" as="geometry" />
