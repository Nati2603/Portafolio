        <mxCell id="nkpL2B2TygAPKRpP-Ec0-32" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;labelBorderColor=default;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Proyecto Personal-Social&lt;/h1&gt;&lt;p&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 14px;&quot;&gt;Facilito el desarrollo de habilidades blandas como la empatía, la comunicación y la resolución de conflictos, promoviendo relaciones saludables y un crecimiento integral.&lt;/font&gt;&lt;/p&gt;" vertex="1">
