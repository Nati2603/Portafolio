        <mxCell id="nkpL2B2TygAPKRpP-Ec0-30" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;labelBorderColor=default;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Proyecto Educativo&lt;/h1&gt;&lt;p&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 14px;&quot;&gt;Apoyo a los estudiantes a identificar y fortalecer su estilo de aprendizaje, potenciando sus habilidades académicas y su autonomía en el estudio.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="180" x="324" y="880" as="geometry" />
        </mxCell>
